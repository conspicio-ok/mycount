# Configuration propre à la machine. Copier en .env (non versionné) et adapter :
#   cp .env.example .env
# Toutes les variables sont optionnelles : les valeurs ci-dessous sont les défauts.
# Le secret JWT ne va pas ici : voir .secrets/JWT_SECRET dans le README.

# Domaine pointant sur le serveur → HTTPS automatique (Let's Encrypt).
# :80 → HTTP simple, pour un lancement local.
SITE_ADDRESS=:80

# Ports publiés sur l'hôte.
HTTP_PORT=80
HTTPS_PORT=443

# Cookies de session Secure : HTTPS, ou http://localhost.
# false uniquement pour un accès HTTP par IP sur un réseau de confiance.
AUTH_COOKIE_SECURE=true

# Images : préfixe et tag. En CI/CD, préfixe = registry GitLab, tag = hash du commit.
MYCOUNT_REGISTRY=mycount
MYCOUNT_TAG=latest
